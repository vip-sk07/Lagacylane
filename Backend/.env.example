# ========================================================
# LEGACYLANE - BACKEND API SERVER CONFIGURATION
# Copy this file to .env and fill in your values
# ========================================================

# 1. Server Port (default 5000)
PORT=5000

# 2. MongoDB Connection URI (default: local MongoDB on 27017)
MONGO_URI=mongodb://127.0.0.1:27017

# 3. CORS - Allowed Frontend Origin
# Set this to your deployed frontend URL in production
ALLOWED_ORIGIN=http://localhost:5173

# 4. Public API URL (used to generate upload URLs returned to the frontend)
# In production: https://your-backend.domain.com
API_BASE_URL=http://localhost:5000
