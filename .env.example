# =========================================================================
# LEGACYLANE — PRODUCTION & CLOUD ENVIRONMENT CONFIGURATION
# Set these environment variables in Render, Railway, Fly.io, or your .env
# =========================================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=production

# 2. Database Persistence (MongoDB Atlas Free Cluster)
# Get free URI from: https://cloud.mongodb.com
# Example: mongodb+srv://dbuser:mypassword@cluster0.abcde.mongodb.net/legacylane?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/legacylane

# 3. Persistent Volume Directory (Optional - for Render/Railway Disks)
# When mounting a persistent disk (e.g. /data), SQLite and uploaded media persist here
# DATA_DIR=/data
# SQLITE_DB_PATH=/data/legacylane.db
# UPLOADS_DIR=/data/uploads

# 4. Google Gemini AI API Key (For Live Dynamic Conversational Younger Self & Vision)
# Free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 5. Cryptographic Security Key (AES-256-GCM Zero-Plaintext Memory Encryption)
# Must be a secret 32-character / 32-byte string
ENCRYPTION_KEY=legacylane-secure-memory-encryption-key-32b!

# 6. CORS Allowed Origins (Optional - defaults to auto-allowing deployment host)
# ALLOWED_ORIGIN=https://your-custom-domain.com
