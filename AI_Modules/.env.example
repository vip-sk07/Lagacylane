# ========================================================
# LEGACYLANE - AI MODULES & VECTOR PIPELINE CONFIGURATION
# ========================================================

# 1. Google Gemini Embedding API Key (text-embedding-004)
# Get key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Local Ollama Server Fallback (Optional)
OLLAMA_HOST=http://localhost:11434

# 3. Supabase pgvector Database Credentials (Optional)
# Enter your Supabase Project URL and Key to persist embeddings to PostgreSQL pgvector
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 4. Memory Journal AES-256 Encryption Key (32 bytes)
ENCRYPTION_KEY=legacylane-secure-memory-encryption-key-32b!
